// The load test's Worker on this machine only (docs/rules/load.md R-LOAD-001):
// the server package's app under `wrangler dev`, with the test sign-in and the
// memory stores. Never deployed: it has no routes, no account and no database id.
{
  "$schema": "../../apps/server/node_modules/wrangler/config-schema.json",
  "name": "japacity-load",
  "main": "../../apps/server/src/load.worker.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  // The same limits as apps/server/wrangler.jsonc (R-SERVER-025), so the run meets them as players would.
  "ratelimits": [
    { "name": "COMMANDS_10S", "namespace_id": "2001", "simple": { "limit": 10, "period": 10 } },
    { "name": "COMMANDS_60S", "namespace_id": "2002", "simple": { "limit": 60, "period": 60 } },
    { "name": "READS_60S", "namespace_id": "2003", "simple": { "limit": 120, "period": 60 } },
    { "name": "ANON_60S", "namespace_id": "2004", "simple": { "limit": 60, "period": 60 } },
    { "name": "SOCKET_10S", "namespace_id": "2005", "simple": { "limit": 10, "period": 10 } }
  ]
}
