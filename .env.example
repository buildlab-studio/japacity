# The local stack: `pnpm dev:full`, `pnpm db:migrate:local` and `pnpm test:browser:real`
# (docs/site/built/working.md, "Running the whole thing locally"; server:production-and-staging).
#
# Every value below is for this machine only. None is a secret, and none reaches a deployment:
# the tools hand them to `wrangler dev` and Vite on their command line and in a git-ignored file
# under apps/server/.wrangler/, never through wrangler.jsonc.
#
# To change one, write the same name with your value in .env.local (git ignores it). The tools read
# only the names in this file, so anything else in .env.local (the Neon link's lines, for one) is
# never used by them, and the local stack never touches a Neon database.

# The game's address: one Worker serves the page and /api, as on a deployment. It must be a bare
# https origin (account:passkey-needs-signed-in-session), so wrangler serves it with its own self-signed
# certificate, and the browser asks once to trust it. The port is the one wrangler listens on.
SITE_URL=https://localhost:8787

# Postgres 18 in Docker Compose (compose.yaml at the repository root). The migrations run against it
# and the Worker reaches it through wrangler's local Hyperdrive (GAME_DB and CACHED_DB both).
# The tools refuse a database that is not on this machine.
LOCAL_DATABASE_URL=postgres://japacity:japacity-local@127.0.0.1:5432/japacity

# Mailpit in Docker Compose: the email codes and notices land in its inbox at this address
# (account:sign-in-routes-rate-limited). `mailpit` is the only transport on this machine; with anything else the Worker uses its MAIL
# binding, which wrangler dev here only simulates, so no mail leaves this machine either way.
MAIL_TRANSPORT=mailpit
MAILPIT_URL=http://localhost:8025

# The bot check: Cloudflare's test keys, which always pass on any address (account:bot-check-on-guest-creation).
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# The Worker's secrets, as `wrangler secret put` sets them on a deployment. These are plain words that only
# work on this machine; a deployment's own are long and random (docs/site/built/your-own-copy.md says how to make them).
BETTER_AUTH_SECRET=local-only-auth-secret-for-this-machine-never-deployed
WORLD_SEED=local-only-world-seed-for-this-machine
BAN_SALT=local-only-ban-salt-for-this-machine
DRAW_TOKEN_KEY=local-only-draw-token-key-for-this-machine

# Google sign-in cannot work locally (its client is registered for the game's own addresses only),
# so these only fill the bindings. Sign in with an email code instead.
GOOGLE_CLIENT_ID=local-none
GOOGLE_CLIENT_SECRET=local-none

# The accounts that may open the admin page (server:ledger-alarm-lists-suspects): comma-separated account ids, from the
# account screen once you have signed up locally. Empty, nobody is an admin. Replace with your own in .env.local.
# On a deployment it is a Worker secret, set with `wrangler secret put ADMIN_ACCOUNTS`.
ADMIN_ACCOUNTS=

# The client's build variables for a deployment. The local stack sets VITE_SERVER_URL and the Turnstile key itself,
# and Vite does not read this file: give these to the build command's environment, as the deploy workflows do from
# the GitHub environment's variables, for example `VITE_SERVER_URL=https://your-domain.example pnpm build`.
# The game's address, a bare https origin; set, the server is the authority (apps/client/src/shared/net/authorityMode.ts).
# VITE_SERVER_URL=<https://your-domain.example>
# Replace with your own Turnstile site key from your Cloudflare dashboard (the widget's hostname is your domain).
# VITE_TURNSTILE_SITE_KEY=<your Turnstile site key>
# Replace with your own Web Analytics tag from your Cloudflare dashboard; empty, the page carries no beacon.
# VITE_ANALYTICS_TOKEN=<your Web Analytics site token>
# The build number feedback carries (moderation:feedback-box-in-settings); the deploy workflows set it to the commit.
# VITE_BUILD=<the short commit, from git rev-parse --short HEAD>
# The commit stamped in the page (server:production-and-staging); unset, the build reads it from git. Not a VITE_ name: the build reads it.
# JAPACITY_BUILD=<the commit>
# Never on a deployment: "1" turns the fast clock on in a dev or preview build (apps/client/src/authority/clock.ts).
# VITE_FAST_CLOCK=<1 for a fast clock in a dev or preview build only>
# Never on a deployment: "1" lets a production build run the game in the browser with no server (engine:browser-authority-for-dev-only).
# VITE_ALLOW_LOCAL_AUTHORITY=<1 for an offline production build only>

# Staging, for `pnpm test:browser:real --staging` and `pnpm play --url https://staging.japacity.app`:
# from your Cloudflare Zero Trust service token; staging only. Never write the values here or in
# .env.local: set them in the environment for one command, from your keychain or secret store.
# The tools read these two from the environment only.
# CF_ACCESS_CLIENT_ID=<from your Cloudflare Zero Trust service token; staging only>
# CF_ACCESS_CLIENT_SECRET=<from your Cloudflare Zero Trust service token; staging only>
