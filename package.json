{
  "name": "japacity",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@11.28.5",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && pnpm -r run typecheck",
    "lint": "NODE_OPTIONS=--max-old-space-size=8192 eslint . --max-warnings 0",
    "test": "vitest run",
    "check:types": "pnpm --filter @japacity/server run types:check",
    "types": "pnpm --filter @japacity/server run types",
    "check:rules": "tsx tools/check/rules.ts",
    "check:protected": "tsx tools/check/protected.ts",
    "check:assets": "tsx tools/assets/assets-check.ts",
    "check:size": "tsx tools/check/size.ts",
    "check:scrub": "tsx tools/check/scrub.ts",
    "check:version": "tsx tools/check/version.ts check",
    "content:seal": "tsx tools/check/version.ts seal",
    "assets:export": "tsx tools/assets/export.ts",
    "assets:shoot": "tsx tools/assets/shoot.ts",
    "assets:outline": "tsx tools/assets/outline.ts",
    "assets:credits": "tsx tools/assets/credits.ts",
    "assets:publish": "tsx tools/assets/publish.ts",
    "notices": "tsx tools/notices.ts",
    "bless": "tsx tools/goldens/bless.ts",
    "record:lives": "tsx tools/goldens/record-lives.ts",
    "play": "tsx tools/play/play.ts",
    "teaser:record": "pnpm --filter @japacity/teaser record",
    "teaser:render": "pnpm --filter @japacity/teaser render",
    "rollback": "tsx apps/server/src/admin/rollback.main.ts",
    "snapshot:all": "tsx apps/server/src/admin/snapshot.main.ts",
    "guests:clean": "tsx apps/server/src/account/clean.main.ts",
    "check": "tsx tools/check/all.ts",
    "dev": "pnpm --filter @japacity/client dev",
    "dev:full": "tsx tools/local/full.ts",
    "db:migrate:local": "tsx tools/local/migrate.ts",
    "build": "pnpm --filter @japacity/client build",
    "test:browser": "playwright test -c apps/client/e2e/playwright.config.ts",
    "test:browser:real": "tsx tools/local/real.ts",
    "catalog": "playwright test -c apps/client/e2e/catalog/playwright.catalog.config.ts",
    "docs:dev": "vitepress dev docs/site --port 5180",
    "docs:build": "vitepress build docs/site",
    "docs:preview": "vitepress preview docs/site --port 5181"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.0",
    "@eslint/js": "^10.0.1",
    "@neon/config": "^1.8.6",
    "@neon/env": "^1.5.3",
    "@playwright/test": "^1.64.0",
    "@types/node": "^24.19.1",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/eslint-plugin": "^1.6.27",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "mermaid": "^11.17.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitepress": "^1.6.4",
    "vitepress-plugin-mermaid": "^2.0.17",
    "vitest": "~4.1.11"
  }
}
