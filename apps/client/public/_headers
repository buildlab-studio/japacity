# The page's own headers. The policy reports and
# does not block yet: watch a week of play, then rename the header to enforce it.
# wasm-unsafe-eval: the models' mesh decoder. challenges.cloudflare.com: the bot check.
# blob: the models' textures, fetched from blob addresses, and the shared cards.
# font-src data: the sign font, small enough that the build inlines it.
# If the server is ever on another address than the page, connect-src names it, with its wss: form.
# static.cloudflareinsights.com and cloudflareinsights.com: Cloudflare Web Analytics' beacon and its reports,
# in the page only when the build has VITE_ANALYTICS_TOKEN (src/shared/analytics/beacon.ts).
/*
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://challenges.cloudflare.com https://static.cloudflareinsights.com; frame-src https://challenges.cloudflare.com; connect-src 'self' blob: https://cloudflareinsights.com; img-src 'self' data: blob:; media-src 'self' blob:; style-src 'self' 'unsafe-inline'; worker-src 'self' blob:; font-src 'self' data:; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
