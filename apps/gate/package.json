{
  "name": "@japacity/gate",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc -p tsconfig.json && tsc -p e2e/tsconfig.json",
    "test:browser": "playwright test -c e2e/playwright.config.ts",
    "db:create": "wrangler d1 create japacity-waitlist",
    "db:schema": "wrangler d1 execute japacity-waitlist --remote --file schema.sql",
    "export": "wrangler d1 execute japacity-waitlist --remote --json --command \"SELECT email, joined_at FROM waitlist ORDER BY joined_at\" | sed -n '/^\\[$/,$p' | jq -r '.[0].results | ([\"email\",\"joined_at\"]), (.[] | [.email, .joined_at]) | @csv'"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20251008.0",
    "@types/node": "^24.19.1",
    "typescript": "~6.0.3",
    "wrangler": "^4.149.0"
  }
}
