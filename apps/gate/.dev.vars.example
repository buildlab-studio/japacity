# The gate's Worker: every secret and variable its code reads (apps/gate/src/index.ts, `Env`), with placeholders.
# On a deployment the secret is set with `wrangler secret put GATE_SECRET` and the variables come from wrangler.jsonc.
# Copy this file to apps/gate/.dev.vars (git ignores it) to run `wrangler dev` here; apps/gate/README.md has the steps.

# The code in the invite link. Unset or empty, the gate admits nobody.
GATE_SECRET=<a long random code>
# The game's X handle without the @. Empty: the screen shows no X link.
GATE_X_HANDLE=
# The game's address, where the screen's card picture is.
SITE_URL=<https://your-domain.example>
# Replace with your own Web Analytics tag from your Cloudflare dashboard. Empty: the screen carries no script.
ANALYTICS_TOKEN=
