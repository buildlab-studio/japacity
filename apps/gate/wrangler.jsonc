// The gate: a Worker on the route japacity.app/* that owns the game's root before launch.
// Without its cookie a visitor sees the holding screen; /invite/<the code> admits a phone, and an admitted
// request is handed on with fetch(request) to the game's Worker, which stays on the host as its Custom Domain.
// At launch the maintainer deletes this route and the game's Worker is the root. Nothing here is deployed
// until the maintainer says so. Steps are in apps/gate/README.md.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "japacity-gate",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": false,
  "preview_urls": false,
  // The game's address: the host of the server's SITE_URL.
  "routes": [{ "pattern": "japacity.app/*", "zone_name": "japacity.app" }],
  // The card picture of the screen's link preview. Every request runs the gate's code first,
  // which serves /card.png from here and nothing else, so no file of the gate's hides one of the game's.
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  // The counts the gate hands the game (src/counts.ts): the holding screen, the invite link, a card's
  // arrival. A service binding to the game's Worker's GateCounters entrypoint, which is not on the
  // internet; no cookie or secret is involved.
  "services": [{ "binding": "GAME", "service": "japacity-server", "entrypoint": "GateCounters" }],
  "vars": {
    // The game's X handle without the @, once the maintainer has claimed it. Empty: the screen shows no X link.
    "GATE_X_HANDLE": "",
    // The game's address, where the screen's card picture is.
    "SITE_URL": "https://japacity.app",
    // The Cloudflare Web Analytics site token (apps/gate/README.md says where it comes from). Empty: the screen carries no script.
    "ANALYTICS_TOKEN": ""
  }
  // The secret, set by the maintainer with `wrangler secret put GATE_SECRET` and never written here.
  // It is also the code in the invite link. Unset or empty, the gate admits nobody.
}
