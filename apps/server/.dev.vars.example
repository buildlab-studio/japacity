# The game's Worker: every secret and variable its code reads (apps/server/src/index.ts, `Env`), with placeholders.
#
# On a deployment the secrets are set once per environment with `wrangler secret put <NAME>` (add `--env staging`
# for staging), never written in a file and never passed on a deploy's command line; the variables come from wrangler.jsonc.
# On this machine `pnpm dev:full` already gives the Worker working local values from .env.example; copy this file to
# apps/server/.dev.vars (git ignores it) only to run `wrangler dev` here by hand. A staging secret is never a production one.
# docs/site/built/your-own-copy.md lists every value that belongs to one deployment.

# Variables (wrangler.jsonc `vars`)
# The game's one address, a bare https origin; the auth library, the passkeys and the bot check trust only it.
SITE_URL=<https://your-domain.example>
# Staging only: the tick cron when it is not the five-minute one (R-CLOCK-012).
TICK_CRON=
# Staging only: "1" marks every reply noindex (R-SERVER-038).
NOINDEX=
# The local stack only: "mailpit" sends mail to Mailpit; unset on every deployment, which sends through its MAIL binding
# (Cloudflare Email Service, wrangler.jsonc). Run by hand without it, wrangler dev only simulates that binding.
MAIL_TRANSPORT=
# Mailpit's address on this machine, for MAIL_TRANSPORT=mailpit.
MAILPIT_URL=
# The private overlay (R-SERVER-018); unset, the public defaults run the game.
OVERLAY=

# Secrets (`wrangler secret put`). Make each random value with `openssl rand -hex 32`.
# The world's seed, made once at the first deploy and never changed (R-SERVER-016).
WORLD_SEED=<a long random value>
# The salt of the banned identities' hashes (R-MODERATION-018).
BAN_SALT=<a long random value>
# The key that signs the draw's ticket tokens (R-LOTTERY-008).
DRAW_TOKEN_KEY=<a long random value>
# The auth library's signing secret, at least 32 characters.
BETTER_AUTH_SECRET=<a long random value>
# Your Google OAuth client, registered with https://<your domain>/api/auth/callback/google as its redirect address.
GOOGLE_CLIENT_ID=<your Google OAuth client id>
GOOGLE_CLIENT_SECRET=<your Google OAuth client secret>
# The secret half of your Turnstile widget, from your Cloudflare dashboard; the site key goes into the client's build.
TURNSTILE_SECRET_KEY=<your Turnstile secret key>
# The web push pair (a P-256 key pair, base64url, as any web push tool makes it) and a mailto: address push services can reach you at.
# Without all three no notice is sent (R-CLOCK-031).
VAPID_PUBLIC_KEY=<your VAPID public key>
VAPID_PRIVATE_KEY=<your VAPID private key>
VAPID_SUBJECT=<mailto: an address of yours>
# The accounts that may open the admin page, comma-separated account ids (R-SERVER-012). Empty: nobody. A secret on a
# deployment (`wrangler secret put ADMIN_ACCOUNTS`), never a variable in wrangler.jsonc.
ADMIN_ACCOUNTS=
