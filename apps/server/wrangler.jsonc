// The game's server: the authority for every character (docs/rules/server.md),
// the clock and the world on a schedule (docs/rules/clock.md), accounts
// (docs/rules/account.md). Nothing here is deployed until the maintainer says so.
// The values that belong to this deployment (the routes, the Hyperdrive ids) are listed for anyone
// running their own copy in docs/site/built/your-own-copy.md.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "japacity-server",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  // Better Auth and node-postgres need the Node compatibility layer (decision 0004, section 1).
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  // The game's one address. Before launch the gate's route on the same host runs first
  // (apps/gate/README.md); deleting that route makes this Worker the root.
  "routes": [{ "pattern": "japacity.app", "custom_domain": true }],
  // One Worker is the whole game: the client's build is served as static assets, and only
  // /api/* reaches the code, so the page and the API share one origin (no CORS, first party cookies).
  // Build the client before a deploy: `pnpm build` from the repository root.
  "assets": {
    "directory": "../client/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    // The game's address. The auth library, the passkeys' relying
    // party (its host, R-ACCOUNT-003), the bot check's host and the origin check on writes trust only this.
    "SITE_URL": "https://japacity.app",
    // Until launch: production ticks every thirty minutes like staging, so both
    // Neon branches sleep between runs and fit the free plan while the gate is closed. On launch day, after Neon
    // moves to a paid plan, remove this var and put the first cron below back to "*/5 * * * *" (apps/gate/README.md).
    "TICK_CRON": "*/30 * * * *"
  },
  // R-CLOCK-012: the world's ticks every five minutes, on TICK_CRON until launch. R-SERVER-011: the money report at 00:00 UTC.
  "triggers": { "crons": ["*/30 * * * *", "0 0 * * *"] },
  // R-SERVER-025 to 027: the limits, counted per location (R-SERVER-028). Periods are 10 or 60 seconds.
  "ratelimits": [
    { "name": "COMMANDS_10S", "namespace_id": "2001", "simple": { "limit": 10, "period": 10 } },
    { "name": "COMMANDS_60S", "namespace_id": "2002", "simple": { "limit": 60, "period": 60 } },
    { "name": "READS_60S", "namespace_id": "2003", "simple": { "limit": 120, "period": 60 } },
    { "name": "ANON_60S", "namespace_id": "2004", "simple": { "limit": 60, "period": 60 } },
    { "name": "SOCKET_10S", "namespace_id": "2005", "simple": { "limit": 10, "period": 10 } }
  ],
  // R-CLOCK-025: one small stateful object per place, holding presence in memory only.
  "durable_objects": { "bindings": [{ "name": "PLACE", "class_name": "Place" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Place"] }],
  // Game state goes through a configuration with caching off; only the world's
  // ticks and the auth library may use the cached one (design 05, section 7).
  // Decision 0004: every request opens one client through GAME_DB and closes it after the reply.
  // Secrets, set by the maintainer with `wrangler secret put <NAME>` and never written here:
  // WORLD_SEED, BAN_SALT, DRAW_TOKEN_KEY, BETTER_AUTH_SECRET, GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET,
  // TURNSTILE_SECRET_KEY, and for the bank-full notice VAPID_PUBLIC_KEY, VAPID_PRIVATE_KEY, VAPID_SUBJECT.
  "hyperdrive": [
    { "binding": "GAME_DB", "id": "REPLACE_WITH_HYPERDRIVE_ID_CACHE_OFF" },
    { "binding": "CACHED_DB", "id": "REPLACE_WITH_HYPERDRIVE_ID_CACHED" }
  ],
  "env": {
    // Staging, behind Cloudflare Access: `wrangler deploy --env staging`. Its own Worker, database,
    // secrets and passkeys; nothing is shared with production. Vars, bindings and the route are not
    // inherited from the top level, so each is written again here.
    "staging": {
      "name": "japacity-server-staging",
      // Inherited from the top level already; written again so staging's own block says it has no
      // workers.dev address and no preview URLs, by choice.
      "workers_dev": false,
      "preview_urls": false,
      "routes": [{ "pattern": "staging.japacity.app", "custom_domain": true }],
      // Workers Logs on staging only: every request and its console lines are kept, so a failure a
      // tester meets can be read from the server's side. Kept 7 days on the paid plan. Production has no such block
      // and keeps whatever its own setting is.
      "observability": { "enabled": true, "head_sampling_rate": 1 },
      // R-SERVER-038: the Worker runs first for every path and serves the client's files through
      // ASSETS, so each reply carries the noindex tag and robots.txt disallows all. Production keeps
      // the platform serving its files first.
      "assets": {
        "directory": "../client/dist",
        "not_found_handling": "single-page-application",
        "binding": "ASSETS",
        "run_worker_first": true
      },
      "vars": {
        "SITE_URL": "https://staging.japacity.app",
        // R-CLOCK-012, R-SERVER-038: staging ticks every thirty minutes so its database can sleep
        // between runs; every five-minute job runs on this cron instead. Equal to the first cron below.
        "TICK_CRON": "*/30 * * * *",
        "NOINDEX": "1"
      },
      "triggers": { "crons": ["*/30 * * * *", "0 0 * * *"] },
      // Namespaces of their own: two Workers on one id would share one count.
      "ratelimits": [
        { "name": "COMMANDS_10S", "namespace_id": "3001", "simple": { "limit": 10, "period": 10 } },
        { "name": "COMMANDS_60S", "namespace_id": "3002", "simple": { "limit": 60, "period": 60 } },
        { "name": "READS_60S", "namespace_id": "3003", "simple": { "limit": 120, "period": 60 } },
        { "name": "ANON_60S", "namespace_id": "3004", "simple": { "limit": 60, "period": 60 } },
        { "name": "SOCKET_10S", "namespace_id": "3005", "simple": { "limit": 10, "period": 10 } }
      ],
      "durable_objects": { "bindings": [{ "name": "PLACE", "class_name": "Place" }] },
      // From `wrangler hyperdrive create` on the staging database.
      "hyperdrive": [
        { "binding": "GAME_DB", "id": "4e7ab412c46743a7b639706e32e84f9a" },
        { "binding": "CACHED_DB", "id": "848c169e921e4aa8adc204c778303439" }
      ]
    }
  }
}
