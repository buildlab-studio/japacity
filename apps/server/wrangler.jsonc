// The game's server: the authority for every character (docs/rules/server.md),
// the clock and the world on a schedule (docs/rules/clock.md), accounts
// (docs/rules/account.md).
// The values that belong to this deployment (the routes, the Hyperdrive ids) are listed for anyone
// running their own copy in docs/site/built/your-own-copy.md.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "japacity-server",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  // Better Auth and node-postgres need the Node compatibility layer (decision 0006, section 1).
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  // server:worker-placed-near-database: run the fetch handler near the database, Neon's London region (aws-eu-west-2), not near
  // the player: one command makes several queries in a row, each a round trip. A placement hint, checked
  // against wrangler 4.149's schema and Cloudflare's placement page on 11 Oct 2026.
  "placement": { "region": "aws:eu-west-2" },
  // server:shared-observability-block: Workers Logs keep every console line (head sampling 1), 7 days on the paid
  // plan, and no invocation log: Cloudflare's own line per request would record the full address with its invite and
  // sign-in codes, the client's IP and place, the user agent and the cookie header. No traces either: a request's
  // root span records the full address with the same codes. Issues groups the failures. Every key was checked against wrangler 4.149's config-schema.json and
  // the Workers Logs, traces, Issues and configuration pages on 11 Oct 2026.
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1, "invocation_logs": false },
    "traces": { "enabled": false },
    "issues": { "enabled": true }
  },
  // The game's one address, answered by this Worker as its Custom Domain.
  "routes": [{ "pattern": "japacity.app", "custom_domain": true }],
  // One Worker is the whole game: the client's build is served as static assets, and only
  // /api/* reaches the code, so the page and the API share one origin (no CORS, first party cookies).
  // Build the client before a deploy: `pnpm build` from the repository root.
  "assets": {
    "directory": "../client/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    // The game's address, the one it is served from. The auth library, the passkeys' relying
    // party (its host, account:passkey-needs-signed-in-session), the bot check's host and the origin check on writes trust only this.
    "SITE_URL": "https://japacity.app"
    // Production's database is on a paid plan that need not sleep, so production sets no TICK_CRON and ticks
    // every five minutes.
  },
  // clock:cron-stores-missing-ticks: the world's ticks every five minutes. server:daily-money-report: the money report at 00:00 UTC.
  "triggers": { "crons": ["*/5 * * * *", "0 0 * * *"] },
  // server:per-account-rate-limits, server:anonymous-limit-by-address and server:noisy-socket-closed: the limits, counted per location (server:limits-are-approximate). Periods are 10 or 60 seconds.
  "ratelimits": [
    { "name": "COMMANDS_10S", "namespace_id": "2001", "simple": { "limit": 10, "period": 10 } },
    { "name": "COMMANDS_60S", "namespace_id": "2002", "simple": { "limit": 60, "period": 60 } },
    { "name": "READS_60S", "namespace_id": "2003", "simple": { "limit": 120, "period": 60 } },
    { "name": "ANON_60S", "namespace_id": "2004", "simple": { "limit": 60, "period": 60 } },
    { "name": "SOCKET_10S", "namespace_id": "2005", "simple": { "limit": 10, "period": 10 } }
  ],
  // clock:presence-held-in-memory: one small stateful object per place, holding presence in memory only.
  "durable_objects": { "bindings": [{ "name": "PLACE", "class_name": "Place" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Place"] }],
  // Game state goes through a configuration with caching off; only the world's
  // ticks and the auth library may use the cached one (design 04, section 7).
  // Decision 0006: every request opens one client through GAME_DB and closes it after the reply.
  // Secrets, set with `wrangler secret put <NAME>` and never written here:
  // WORLD_SEED, BAN_SALT, DRAW_TOKEN_KEY, BETTER_AUTH_SECRET, GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET,
  // TURNSTILE_SECRET_KEY, ADMIN_ACCOUNTS (server:ledger-alarm-lists-suspects: the admin list, never a var here), and for the bank-full
  // notice VAPID_PUBLIC_KEY, VAPID_PRIVATE_KEY, VAPID_SUBJECT.
  // From `wrangler hyperdrive create` on production's database: the game
  // configuration with caching off, the cached one for the ticks and the auth library.
  "hyperdrive": [
    { "binding": "GAME_DB", "id": "dfa35042f0eb48d9beefaeae053a5408" },
    // CACHED_DB is read by nothing. It stays bound for the reads design 04 section 7 allows
    // from a cache: the world's ticks and the auth library. The world's reply is kept by the Cache API instead
    // (server:public-replies-cached), because reading a tick may store a missing one, a write a cached configuration must not serve.
    { "binding": "CACHED_DB", "id": "d5b2792f9d3f46fcb79bf6aa79ad5802" }
  ],
  // account:sign-in-routes-rate-limited, decision 0007: the email codes and the notices leave through Cloudflare Email Service, from
  // the sending subdomain onboarded for it. The binding may send from the game's one sender and no other
  // address (SENDER in src/mail/mail.ts, held equal by its test). It needs no secret.
  "send_email": [{ "name": "MAIL", "allowed_sender_addresses": ["game@mail.japacity.app"] }],
  "env": {
    // Staging, behind Cloudflare Access: `wrangler deploy --env staging`. Its own Worker, database,
    // secrets and passkeys; nothing is shared with production. Vars, bindings and the route are not
    // inherited from the top level, so each is written again here.
    "staging": {
      "name": "japacity-server-staging",
      // Inherited from the top level already; written again so staging's own block says it has no
      // workers.dev address and no preview URLs.
      "workers_dev": false,
      "preview_urls": false,
      // server:worker-placed-near-database: near staging's database, also in Neon's London region, written again so the block says it.
      "placement": { "region": "aws:eu-west-2" },
      "routes": [{ "pattern": "staging.japacity.app", "custom_domain": true }],
      // No observability block: `observability` is one of the keys an environment inherits (wrangler's configuration
      // page, "Inheritable keys"), so staging keeps the top level's logs, traces and Issues (server:shared-observability-block).
      // server:production-and-staging: the Worker runs first for every path and serves the client's files through
      // ASSETS, so each reply carries the noindex tag and robots.txt disallows all. Production keeps
      // the platform serving its files first.
      "assets": {
        "directory": "../client/dist",
        "not_found_handling": "single-page-application",
        "binding": "ASSETS",
        "run_worker_first": true
      },
      "vars": {
        "SITE_URL": "https://staging.japacity.app",
        // clock:cron-stores-missing-ticks, server:production-and-staging: staging ticks every thirty minutes so its database can sleep
        // between runs; every five-minute job runs on this cron instead. Equal to the first cron below.
        "TICK_CRON": "*/30 * * * *",
        "NOINDEX": "1"
      },
      "triggers": { "crons": ["*/30 * * * *", "0 0 * * *"] },
      // Namespaces of their own: two Workers on one id would share one count.
      "ratelimits": [
        { "name": "COMMANDS_10S", "namespace_id": "3001", "simple": { "limit": 10, "period": 10 } },
        { "name": "COMMANDS_60S", "namespace_id": "3002", "simple": { "limit": 60, "period": 60 } },
        { "name": "READS_60S", "namespace_id": "3003", "simple": { "limit": 120, "period": 60 } },
        { "name": "ANON_60S", "namespace_id": "3004", "simple": { "limit": 60, "period": 60 } },
        { "name": "SOCKET_10S", "namespace_id": "3005", "simple": { "limit": 10, "period": 10 } }
      ],
      "durable_objects": { "bindings": [{ "name": "PLACE", "class_name": "Place" }] },
      // From `wrangler hyperdrive create` on the staging database.
      "hyperdrive": [
        { "binding": "GAME_DB", "id": "4e7ab412c46743a7b639706e32e84f9a" },
        { "binding": "CACHED_DB", "id": "848c169e921e4aa8adc204c778303439" }
      ],
      // As at the top level: the codes and the notices, from the game's one sender only.
      "send_email": [{ "name": "MAIL", "allowed_sender_addresses": ["game@mail.japacity.app"] }]
    }
  }
}
