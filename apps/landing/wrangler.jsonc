// The holding page, kept switched off and not deployed: it has no route and no workers.dev address,
// and japacity.app belongs to the gate or the game (apps/gate). One Worker and its card picture. With
// LANDING_LIVE off it says the game opens soon; on, it shows the play link. The waitlist is switched
// off: its code and tests stay, its two bindings are commented out below. Steps are in apps/landing/README.md.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "japacity-landing",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  // Not deployed: no workers.dev address and no route.
  "workers_dev": false,
  // The same logs, traces and Issues as the game's Worker (apps/server/wrangler.jsonc, R-SERVER-042), for the day it is deployed.
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1, "invocation_logs": true },
    "traces": { "enabled": true, "head_sampling_rate": 0.05 },
    "issues": { "enabled": true }
  },
  "assets": { "directory": "./public" },
  "vars": {
    // The Web Analytics site token from the Cloudflare dashboard. Empty: no analytics script is served.
    "ANALYTICS_TOKEN": "",
    "SITE_URL": "https://japacity.app",
    // "true": the page shows the play link instead of "opens soon".
    "LANDING_LIVE": "false",
    // The game's address the play link opens: the server's SITE_URL.
    "LANDING_PLAY_URL": "https://japacity.app",
    // The game's X handle without the @, once it is claimed. Empty: no X link.
    "LANDING_X_HANDLE": "",
    // "true" turns the waitlist on, with the two bindings below uncommented.
    "LANDING_WAITLIST": "false"
  }
  // The waitlist's bindings, kept for the day it is switched on (README, "The waitlist, switched off"):
  // "d1_databases": [
  //   {
  //     "binding": "DB",
  //     "database_name": "japacity-waitlist",
  //     // Filled from the output of `pnpm db:create`.
  //     "database_id": "REPLACE_WITH_DATABASE_ID"
  //   }
  // ],
  // // Five joins a minute from one connection, counted per Cloudflare location.
  // "ratelimits": [{ "name": "JOIN_LIMIT", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }]
}
