// The holding page and its waitlist. One Worker, one D1 table, nothing else.
// Steps that need the maintainer are in apps/landing/README.md.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "japacity-landing",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  // Set to false once the custom domain below is live.
  "workers_dev": true,
  "routes": [{ "pattern": "japacity.com", "custom_domain": true }],
  "assets": { "directory": "./public" },
  "vars": {
    // The Web Analytics site token from the Cloudflare dashboard. Empty: no analytics script is served.
    "ANALYTICS_TOKEN": "",
    "SITE_URL": "https://japacity.com"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "japacity-waitlist",
      // Filled from the output of `pnpm db:create`.
      "database_id": "REPLACE_WITH_DATABASE_ID"
    }
  ],
  // Five joins a minute from one connection, counted per Cloudflare location.
  "ratelimits": [{ "name": "JOIN_LIMIT", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }]
}
