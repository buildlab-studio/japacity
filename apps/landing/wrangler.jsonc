// The holding page. One Worker and its card picture. Before launch it says the game opens soon;
// on launch day LANDING_LIVE shows the play link (PENDING.md P9).
// The waitlist is switched off: its code and tests stay, its two bindings are commented out below.
// Steps that need the maintainer are in apps/landing/README.md.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "japacity-landing",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  // Set to false once the custom domain below is live.
  "workers_dev": true,
  "routes": [{ "pattern": "japacity.com", "custom_domain": true }],
  "assets": { "directory": "./public" },
  "vars": {
    // The Web Analytics site token from the Cloudflare dashboard. Empty: no analytics script is served.
    "ANALYTICS_TOKEN": "",
    "SITE_URL": "https://japacity.com",
    // "true" on launch day: the page shows the play link instead of "opens soon".
    "LANDING_LIVE": "false",
    // The game's address the play link opens: the server's SITE_URL.
    "LANDING_PLAY_URL": "https://play.japacity.com",
    // The game's X handle without the @, once the maintainer has claimed it. Empty: no X link.
    "LANDING_X_HANDLE": "",
    // "true" turns the waitlist back on, with the two bindings below uncommented. Off for launch.
    "LANDING_WAITLIST": "false"
  }
  // The waitlist's bindings, kept for the day it is switched on (README, "The waitlist, switched off"):
  // "d1_databases": [
  //   {
  //     "binding": "DB",
  //     "database_name": "japacity-waitlist",
  //     // Filled from the output of `pnpm db:create`.
  //     "database_id": "REPLACE_WITH_DATABASE_ID"
  //   }
  // ],
  // // Five joins a minute from one connection, counted per Cloudflare location.
  // "ratelimits": [{ "name": "JOIN_LIMIT", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }]
}
